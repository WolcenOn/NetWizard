{
  "name": "netwizard-pro-static",
  "version": "3.50.0",
  "private": true,
  "scripts": {
    "test": "node tests/run-unit-tests.js",
    "check:syntax": "node scripts/check-syntax.js",
    "test:e2e": "npx playwright test",
    "test:e2e:install": "npx playwright install chromium",
    "serve": "node scripts/serve-static.js",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:report": "npx playwright show-report",
    "build:zip": "node scripts/build-zip.js",
    "build:pages": "node scripts/build-pages.js",
    "release:check": "npm run i18n:check && npm run i18n:audit -- --check && npm test && npm run check:syntax && npm run audit:xss",
    "audit:xss": "node scripts/audit-xss.js",
    "i18n:check": "node scripts/i18n-check.js",
    "i18n:sync": "node scripts/i18n-sync.js",
    "i18n:new": "node scripts/i18n-new-locale.js",
    "i18n:audit": "node scripts/i18n-audit-hardcoded.js"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0"
  }
}
