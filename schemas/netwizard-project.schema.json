            "patch-switch",
            "manual"
          ]
        }
      }
    },
    "designLocationPlan": {
      "type": "object",
      "required": [
        "id",
        "locationId",
        "rackMode",
        "capacityPolicy",
        "rackPolicy",
        "demands"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "locationId": {
          "$ref": "#/$defs/id"
        },
        "rackMode": {
          "type": "string",
          "enum": [
            "own",
            "served",
            "none"
          ]
        },
        "servingLocationId": {
          "$ref": "#/$defs/idNullable"
        },
        "capacityPolicy": {
          "$ref": "#/$defs/designCapacityPolicy"
        },
        "rackPolicy": {
          "$ref": "#/$defs/designRackPolicy"
        },
        "demands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/designDemand"
          }
        }
      }
    },
    "designDemand": {
      "type": "object",
      "required": [
        "id",
        "label",
        "category",
        "count",
        "media",
        "speedMinMbps",
        "poeRequired",
        "poeWattsEach"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "maxLength": 40
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "media": {
          "type": "string",
          "maxLength": 40
        },
        "speedMinMbps": {
          "type": "number",
          "minimum": 0
        },
        "poeRequired": {
          "type": "boolean"
        },
        "poeWattsEach": {
          "type": "number",
          "minimum": 0
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}
